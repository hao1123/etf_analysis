# 复制为 .env.etf 后填写。QQ邮箱需使用SMTP授权码，不是登录密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_account@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
MAIL_FROM=your_account@qq.com
MAIL_TO=receiver@example.com
SMTP_SSL=1
SMTP_STARTTLS=0

# 默认忽略系统代理，避免本机失效代理干扰免费行情接口。
ETF_USE_SYSTEM_PROXY=0
LOG_LEVEL=INFO

# 飞书群机器人 Webhook（可选，未配置则只发邮件）
FEISHU_WEBHOOK=
# 飞书机器人加签密钥（可选，仅当机器人启用签名校验时填写）
FEISHU_SECRET=
# 信号即成交时的默认持仓份数
HOLDINGS_AMOUNT=1000
